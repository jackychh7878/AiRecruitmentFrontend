# AI Recruitment Frontend Environment Configuration
# Copy this file to .env.local and update the values for your environment

# ================================
# API Configuration
# ================================

# Development - Local Backend
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production - Azure Container Apps
# NEXT_PUBLIC_API_URL=https://ai-recruitment-backend.grayisland-39090923.eastasia.azurecontainerapps.io/api

# ================================
# Environment Settings
# ================================

# Current environment (development, staging, production)
NODE_ENV=development

# Enable/disable debug features (shows session ID and typewriter speed in chatbot)
NEXT_PUBLIC_DEBUG=true

# ================================
# Feature Flags
# ================================

# Enable chatbot feature
NEXT_PUBLIC_ENABLE_CHATBOT=true

# Enable advanced search statistics
NEXT_PUBLIC_ENABLE_SEARCH_STATS=true

# Enable bulk operations
NEXT_PUBLIC_ENABLE_BULK_OPERATIONS=true

# ================================
# UI Configuration
# ================================

# Application title
NEXT_PUBLIC_APP_NAME="AI Recruitment System"

# Organization name
NEXT_PUBLIC_ORG_NAME="Your Organization"

# Maximum file upload size (in MB)
NEXT_PUBLIC_MAX_FILE_SIZE=10

# ================================
# Analytics & Monitoring (Optional)
# ================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ================================
# Performance Settings
# ================================

# Default pagination size
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# Search debounce delay (milliseconds)
NEXT_PUBLIC_SEARCH_DEBOUNCE=500

# API request timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# ================================
# N8N Chatbot Webhook Configuration
# ================================

# N8N webhook URL for chatbot integration, authentication header key & value
NEXT_PUBLIC_N8N_WEBHOOK_URL=
NEXT_PUBLIC_N8N_AUTH_KEY=n8n_test
NEXT_PUBLIC_N8N_AUTH_VALUE=n8n_test

# Typewriter effect configuration
# Speed in milliseconds per word (lower = faster)
NEXT_PUBLIC_TYPEWRITER_SPEED=100

# Enable/disable typewriter effect (true/false)
NEXT_PUBLIC_ENABLE_TYPEWRITER=true

# ================================
# Security Settings
# ================================

# CORS allowed origins (for development)
# NEXT_PUBLIC_CORS_ORIGINS=http://localhost:3000

# ================================
# Instructions
# ================================

# 1. Copy this file to .env.local
# 2. Update NEXT_PUBLIC_API_URL based on your environment:
#    - For local development: http://localhost:5000/api
#    - For production: https://ai-recruitment-backend.grayisland-39090923.eastasia.azurecontainerapps.io/api
# 3. Adjust other settings as needed for your setup
# 4. Never commit .env.local to version control 